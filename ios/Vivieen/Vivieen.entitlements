<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The Keychain refuses every write with -34018 unless the app has an
       access group; unsigned Simulator builds get none by default, which
       is where solo mode's synced keys were being dropped on the floor
       (2026-08-03). -->
  <key>keychain-access-groups</key>
  <array>
    <!-- Literal, NOT $(AppIdentifierPrefix)...: ad-hoc simulator signing
         has no team prefix to expand, and Xcode strips the whole array,
         leaving an empty entitlements dict and -34018 all over again. -->
    <string>com.vivieen.pocket</string>
  </array>
  <!-- Contact NOTES are Apple-gated: this entitlement works in the
       Debug/simulator build (which is the only config wired to this
       file), but a TestFlight/App Store build needs Apple's per-app
       approval first - apply at developer.apple.com/contact/request/
       contact-note-field. AgentHands degrades honestly without it. -->
  <key>com.apple.developer.contacts.notes</key>
  <true/>
</dict>
</plist>
